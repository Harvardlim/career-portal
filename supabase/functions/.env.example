# Secrets for the Stripe edge functions.
#
# Local dev: copy to `supabase/functions/.env` and run
#   supabase functions serve stripe-checkout --no-verify-jwt --env-file supabase/functions/.env
#   supabase functions serve stripe-webhook  --no-verify-jwt --env-file supabase/functions/.env
#
# Deployed: set them once with
#   supabase secrets set STRIPE_SECRET_KEY=sk_live_... STRIPE_WEBHOOK_SECRET=whsec_...
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically when deployed.)

# Stripe API secret key — Dashboard > Developers > API keys
STRIPE_SECRET_KEY=sk_test_xxx

# Signing secret for the webhook endpoint — shown when you create the endpoint
# in Dashboard > Developers > Webhooks, or printed by `stripe listen`.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Only needed locally (the platform injects these when deployed):
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# Fallback origin for Checkout return URLs when the request carries no Origin
# header (e.g. curl). The browser flow sends its own origin and ignores this.
SITE_URL=http://localhost:5173
