VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Production: set VITE_SUPABASE_URL=/api so the browser talks to
# https://www.partly.asia/api/... (proxied to Supabase by vercel.json) instead of
# <ref>.supabase.co. To use the same path in local dev, also set
# SUPABASE_PROXY_TARGET=https://<ref>.supabase.co
SUPABASE_PROXY_TARGET=
